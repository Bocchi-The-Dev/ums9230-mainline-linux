# SPDX-License-Identifier: GPL-2.0
#
# Android (AOSP) enablement fragment for arm64.
#
# arch/arm64/configs/defconfig is a general-purpose Linux config: it has no
# binder, no binderfs, no dma-buf heaps, no SELinux and no Android filesystems,
# so an Android userspace started on it dies before init can do anything
# useful. Merge this fragment onto defconfig (the CI workflow does exactly
# that) and Android's init, servicemanager, hwservicemanager and
# vndservicemanager find the interfaces they expect.
#
# Deliberately absent, because mainline no longer carries them:
#   - ashmem: removed; Android 11+ allocates shared memory with memfd_create()
#     through libcutils, of which there is nothing to enable
#   - ION: replaced by dma-buf heaps, enabled below
#   - logger: removed; logd keeps its own ring buffers in userspace
#   - kernel low memory killer: removed; lmkd uses PSI, enabled below
#   - sw_sync is still here (Android's sync framework), ashmem is not

# --- binder ------------------------------------------------------------------
# The three contexts Android expects; the values also become the defaults for
# the binder.devices= boot parameter.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- SELinux -----------------------------------------------------------------
# Android is permissive=0 out of the box and init reads androidboot.selinux=
# from the bootloader command line; BOOTPARAM keeps the kernel half of that
# working so a bad policy can still be brought up.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITYFS=y

# --- memory management / pressure -------------------------------------------
# lmkd, the freezer, uclamp and the cgroup v2 device controller are all used by
# Android userspace; none of them are in defconfig.
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# --- graphics buffers --------------------------------------------------------
# gralloc allocates through /dev/dma_heap/system and /dev/dma_heap/system-uncached
# (system heap) and /dev/dma_heap/linux,cma (CMA heap). ION is not an option on
# a mainline kernel.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_SW_SYNC=y

# --- filesystems -------------------------------------------------------------
# userdata is f2fs or ext4 (file based encryption on top), the system/product
# partitions are erofs, /mnt/user is FUSE-backed scoped storage, and the
# dynamic partitions are device-mapper.
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_FUSE_FS=y
CONFIG_TMPFS_XATTR=y

# --- verified boot and file based encryption ---------------------------------
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_DM_VERITY_FEC=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_ADIANTUM=y

# --- swap and crash logs -----------------------------------------------------
# zram backs Android's swap; ramoops is described by the board device tree and
# is where panic/console output survives a reboot.
CONFIG_ZRAM=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y

# --- USB gadget --------------------------------------------------------------
# adb and fastboot userspace talk to the kernel through functionfs; the
# gadget configfs tree is what Android's USB HAL writes to. MTP/PTP use
# functionfs too, so no separate option is needed for them.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y

# --- CPU frequency -----------------------------------------------------------
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
