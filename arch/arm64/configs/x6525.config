# SPDX-License-Identifier: GPL-2.0
#
# Infinix X6525 (Infinix Smart 8), Unisoc UMS9230 / T606.
#
# Device fragment: everything the board device tree
# (arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts) needs to probe and stay
# up long enough to reach Android init. Merge it after android.config:
#
#   make ARCH=arm64 O=out defconfig
#   scripts/kconfig/merge_config.sh -m -O out out/.config \
#       arch/arm64/configs/android.config arch/arm64/configs/x6525.config
#   make ARCH=arm64 O=out olddefconfig && make ARCH=arm64 O=out Image dtbs modules
#
# defconfig has ARCH_SPRD=y but none of the SoC drivers below, because they are
# only selected by the board device trees; built-in rather than modular so the
# console, storage, panel and USB work before any module is loaded.

# --- SoC core ----------------------------------------------------------------
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS9230_CLK=y
CONFIG_PINCTRL_SPRD=y
CONFIG_PINCTRL_SPRD_UMS9230=y
CONFIG_GPIO_SPRD=y
CONFIG_GPIO_EIC_SPRD=y
CONFIG_GPIO_PMIC_EIC_SPRD=y
CONFIG_SPRD_DMA=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_SPRD_MBOX=y
CONFIG_SPRD_PM_DOMAINS=y
CONFIG_SPRD_IOMMU=y
CONFIG_SPRD_THERMAL=y
CONFIG_SPRD_WATCHDOG=y
CONFIG_PM_DEVFREQ=y

# --- console ----------------------------------------------------------------
# The board's chosen/stdout-path is serial1 (ttyS1) at 115200, which is where
# the stock bootloader puts the console too.
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y

# --- PMIC, regulators, charger, gauges --------------------------------------
CONFIG_MFD_SC27XX_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_SC2730=y
CONFIG_IIO=y
CONFIG_SC27XX_ADC=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_POWER_SUPPLY=y
CONFIG_FUEL_GAUGE_SC27XX=y
CONFIG_CHARGER_BQ2415X=y
CONFIG_CHARGER_EXTCON_DETECT=y
CONFIG_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_SC27XX_PD=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SC27XX=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SC27XX_EFUSE=y
CONFIG_NVMEM_SPRD_EFUSE=y
CONFIG_POWER_RESET_SC27XX=y
CONFIG_INPUT_SC27XX_VIBRA=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_SC27XX_BLTC=y
CONFIG_LEDS_SPRD_FLASH=y

# --- storage -----------------------------------------------------------------
# eMMC units boot from sdio3; UFS units from the UFS controller. Both are
# described in the board tree, and only the populated one probes.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SPRD=y
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_SPRD=y

# --- display and GPU ---------------------------------------------------------
# The TD4160 HX panel driver and the DRM_SPRD changes it needs come from the
# X6525 patch set; the panel takes its brightness over DCS, so there is no
# pwm-backlight node on this board.
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_SPRD=y
CONFIG_DRM_PANEL_TD4160_HX=y
CONFIG_DRM_PANFROST=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- input -------------------------------------------------------------------
# The touchscreen is the OmniVision TCM part on spi3, whose firmware is
# downloaded by the driver at probe time (hdl_firmware_01.img from the stock
# vendor partition has to be made available under /lib/firmware).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_TOUCHSCREEN_OVT_TCM_SPI=y

# --- camera ------------------------------------------------------------------
# Rear S5K3L6 on the 2p2ro CSI port, front OV8856 on the 4-lane port; both are
# described in the board tree and driven through the Unisoc camera subsystem.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_SPRD_CAMSYS=y
CONFIG_VIDEO_SPRD_ISP=y
CONFIG_VIDEO_S5K3L6=y
CONFIG_VIDEO_OV8856=y

# --- video codec -------------------------------------------------------------
# VSP power domain, IOMMU attachment and the JPEG block; the stateless H.264
# decoder in the same driver is experimental and unverified on hardware.
CONFIG_VIDEO_SPRD_VSP=y

# --- USB ---------------------------------------------------------------------
# The SoC USB controller is MUSB (sprd,ums9230-musb); the role switch comes
# from the SC2730 Type-C/PD controller. USB_MUSB_DUAL_ROLE is what allows host
# mode with an OTG adapter.
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SPRD=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_PHY_SPRD_USB2=y

# --- connectivity ------------------------------------------------------------
# Wi-Fi, Bluetooth, modem and GNSS all live behind the WCN/modem remoteprocs
# and need the vendor firmware blobs from the stock partitions at runtime.
CONFIG_REMOTEPROC=y
CONFIG_SPRD_REMOTEPROC_COMMON=y
CONFIG_SPRD_WCN_REMOTEPROC=y
CONFIG_SPRD_MODEM_REMOTEPROC=y
CONFIG_SPRD_PMSYS_REMOTEPROC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_SPRD_SIPC=y
# BT is tristate and depends on (RFKILL || !RFKILL); defconfig has RFKILL=m,
# which caps BT at =m no matter what the fragment asks for, and BT_SPRDSIPC
# additionally depends on BT_HCIUART (also =m in defconfig). Promote both so
# the Bluetooth driver really is built in.
CONFIG_RFKILL=y
CONFIG_BT_HCIUART=y
CONFIG_BT=y
CONFIG_BT_SPRDSIPC=y
CONFIG_GNSS=y
CONFIG_GNSS_SPRD=y

# --- audio -------------------------------------------------------------------
# The board tree describes the SC2730 codec and the SoC audio card, but this
# tree has no sound/soc driver for the UMS9230 card yet.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
